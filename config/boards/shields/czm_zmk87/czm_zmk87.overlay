#include <dt-bindings/gpio/gpio.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
    };

    // CZM ZMK87 wireless TKL: 6 x 16 key matrix (96 positions).
    //
    // Hardware diode wiring: ROW pins are the strobes (outputs, driven high
    // one at a time); COL pins are the sense lines (inputs with internal
    // pull-up, read active-low through the diode). This is ZMK's "row2col"
    // diode direction (row drives -> col senses; the matrix position index
    // is row * columns + col, i.e. position (r,c) = r*16 + c, so no matrix
    // transform is needed and keymap bindings map 1:1 to (row,col)).
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        debounce-press-ms = <5>;
        debounce-release-ms = <5>;

        diode-direction = "row2col";

        // Rows = strobe outputs (drive high to scan)
        row-gpios
            = <&gpio0 10 GPIO_ACTIVE_HIGH>   // R0
            , <&gpio0 13 GPIO_ACTIVE_HIGH>   // R1
            , <&gpio0 24 GPIO_ACTIVE_HIGH>   // R2
            , <&gpio0  9 GPIO_ACTIVE_HIGH>   // R3
            , <&gpio0 28 GPIO_ACTIVE_HIGH>   // R4
            , <&gpio1 10 GPIO_ACTIVE_HIGH>   // R5
            ;

        // Cols = sense inputs (pulled up, active-low through diode)
        col-gpios
            = <&gpio0 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // C0
            , <&gpio0 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // C1
            , <&gpio0  7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // C2
            , <&gpio1  9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // C3
            , <&gpio0  5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // C4
            , <&gpio0 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // C5
            , <&gpio0  4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // C6
            , <&gpio0  8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // C7
            , <&gpio0  6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // C8
            , <&gpio0 26 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // C9
            , <&gpio0 30 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // C10
            , <&gpio0 29 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // C11
            , <&gpio0  2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // C12
            , <&gpio1 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // C13
            , <&gpio0  3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // C14
            , <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // C15
            ;
    };

    // Monochrome indicator LEDs.
    // Wiring per LED: 3.3V rail -> resistor -> LED anode (+),
    //                 LED cathode (-) -> GPIO.
    // Active-low: GPIO driven LOW turns the LED on (handled by gpio-leds).
    // NOTE: led index must match LED_* in src/czm_zmk87_indicator.c.
    //   CAPS / SL are on gpio0; BLE1..3 / USB are on gpio1.
    // (P0.31 STBY is the hardware charge lamp chain and is NOT managed here.)
    leds {
        compatible = "gpio-leds";
        label = "CZM ZMK87 indicator LEDs";
        led0: led_0 { gpios = <&gpio0 20 GPIO_ACTIVE_LOW>; };  // CapsLock
        led1: led_1 { gpios = <&gpio0 22 GPIO_ACTIVE_LOW>; };  // ScrollLock
        led2: led_2 { gpios = <&gpio1  0 GPIO_ACTIVE_LOW>; };  // BLE profile 1
        led3: led_3 { gpios = <&gpio1  2 GPIO_ACTIVE_LOW>; };  // BLE profile 2
        led4: led_4 { gpios = <&gpio1  4 GPIO_ACTIVE_LOW>; };  // BLE profile 3
        led5: led_5 { gpios = <&gpio1  6 GPIO_ACTIVE_LOW>; };  // USB output
    };
};
