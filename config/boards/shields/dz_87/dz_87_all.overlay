// Build-time extra overlay for universal ALL (94 keys).
// Passing -DDTC_OVERLAY_FILE drops the auto-added dz_87.keymap, so include it
// here explicitly. dz_87.overlay / board overlay / snippet are still auto-added.
#include "dz_87.keymap"

/ {
    chosen {
        zmk,physical-layout = <&dz87_all>;
    };
};
