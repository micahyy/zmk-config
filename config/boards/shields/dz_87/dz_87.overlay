#include <dt-bindings/gpio/gpio.h>
#include "dz_87-layouts.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = <&dz87_layout>;
    };

    // CZM DZ 87 wireless TKL: 6 x 16 key matrix (96 positions).
    //
    // Hardware diode wiring (confirmed against schematic): diodes point from
    // ROW to COL (anode on the row line, cathode on the column line), i.e.
    // QMK's COL2ROW matrix: COL pins are the strobes (outputs, driven LOW one
    // at a time to select the column), ROW pins are the sense lines (inputs
    // with internal pull-up; a pressed key pulls the row low through the
    // diode, read active-low). ZMK names this by signal/current flow, so the
    // matching enum is "col2row" (col drives -> row senses; verified against
    // app/drivers/kscan/kscan_gpio_matrix.c: for col2row outputs=cols,
    // inputs=rows, and state index = input_idx * cols + output_idx). The
    // matrix position index is still row * columns + col, i.e. position
    // (r,c) = r*16 + c, so no matrix transform is needed and keymap bindings
    // map 1:1 to (row,col).
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        debounce-press-ms = <5>;
        debounce-release-ms = <5>;

        diode-direction = "col2row";

        // Rows = sense inputs (internal pull-up; pressed -> pulled low -> active-low)
        row-gpios
            = <&gpio0 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // R0
            , <&gpio0 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // R1
            , <&gpio0 24 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // R2
            , <&gpio0  9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // R3
            , <&gpio0 28 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // R4
            , <&gpio1 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // R5
            ;

        // Cols = strobe outputs (idle high; driven low one at a time to scan)
        col-gpios
            = <&gpio0 17 GPIO_ACTIVE_LOW>   // C0
            , <&gpio0 15 GPIO_ACTIVE_LOW>   // C1
            , <&gpio0  7 GPIO_ACTIVE_LOW>   // C2
            , <&gpio1  9 GPIO_ACTIVE_LOW>   // C3
            , <&gpio0  5 GPIO_ACTIVE_LOW>   // C4
            , <&gpio0 12 GPIO_ACTIVE_LOW>   // C5
            , <&gpio0  4 GPIO_ACTIVE_LOW>   // C6
            , <&gpio0  8 GPIO_ACTIVE_LOW>   // C7
            , <&gpio0  6 GPIO_ACTIVE_LOW>   // C8
            , <&gpio0 26 GPIO_ACTIVE_LOW>   // C9
            , <&gpio0 30 GPIO_ACTIVE_LOW>   // C10
            , <&gpio0 29 GPIO_ACTIVE_LOW>   // C11
            , <&gpio0  2 GPIO_ACTIVE_LOW>   // C12
            , <&gpio1 13 GPIO_ACTIVE_LOW>   // C13
            , <&gpio0  3 GPIO_ACTIVE_LOW>   // C14
            , <&gpio1 11 GPIO_ACTIVE_LOW>   // C15
            ;
    };

    // Monochrome indicator LEDs.
    // Wiring per LED: 3.3V rail -> resistor -> LED anode (+),
    //                 LED cathode (-) -> GPIO.
    // Active-low: GPIO driven LOW turns the LED on (handled by gpio-leds).
    // NOTE: led index must match LED_* in src/czm_dz_87_indicator.c.
    //   CAPS / SL are on gpio0; BLE1..3 / USB are on gpio1.
    // (P0.31 STBY is the hardware charge lamp chain and is NOT managed here.)
    leds {
        compatible = "gpio-leds";
        label = "CZM DZ 87 indicator LEDs";
        led0: led_0 { gpios = <&gpio0 20 GPIO_ACTIVE_LOW>; };  // CapsLock
        led1: led_1 { gpios = <&gpio0 22 GPIO_ACTIVE_LOW>; };  // ScrollLock
        led2: led_2 { gpios = <&gpio1  0 GPIO_ACTIVE_LOW>; };  // BLE profile 1
        led3: led_3 { gpios = <&gpio1  2 GPIO_ACTIVE_LOW>; };  // BLE profile 2
        led4: led_4 { gpios = <&gpio1  4 GPIO_ACTIVE_LOW>; };  // BLE profile 3
        led5: led_5 { gpios = <&gpio1  6 GPIO_ACTIVE_LOW>; };  // USB output
    };
};
