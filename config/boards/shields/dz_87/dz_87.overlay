#include <dt-bindings/gpio/gpio.h>
#include "dz_87-layouts.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = <&dz87_625>;
    };

    // CZM DZ 87 wireless TKL: 6 x 16 key matrix (96 positions).
    //
    // Hardware diode wiring (confirmed by hardware designer): diodes point
    // from COL to ROW (anode on the column line, cathode on the row line),
    // i.e. ZMK "col2row". ZMK's kscan-gpio-matrix scans ACTIVE-HIGH: columns
    // are strobed HIGH one at a time (GPIO_ACTIVE_HIGH outputs), rows are
    // inputs with internal pull-down; a pressed key pulls the row HIGH through
    // the diode. This matches the official ZMK col2row wiring (corne, contra,
    // eek shields): col-gpios = GPIO_ACTIVE_HIGH,
    // row-gpios = GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN.
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        debounce-press-ms = <5>;
        debounce-release-ms = <5>;

        diode-direction = "col2row";

        // Rows = sense inputs (internal pull-down; pressed -> pulled high -> active-high)
        row-gpios
            = <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // R0
            , <&gpio0 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // R1
            , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // R2
            , <&gpio0  9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // R3
            , <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // R4
            , <&gpio1 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // R5
            ;

        // Cols = strobe outputs (idle low; driven HIGH one at a time to scan)
        col-gpios
            = <&gpio0 17 GPIO_ACTIVE_HIGH>   // C0
            , <&gpio0 15 GPIO_ACTIVE_HIGH>   // C1
            , <&gpio0  7 GPIO_ACTIVE_HIGH>   // C2
            , <&gpio1  9 GPIO_ACTIVE_HIGH>   // C3
            , <&gpio0  5 GPIO_ACTIVE_HIGH>   // C4
            , <&gpio0 12 GPIO_ACTIVE_HIGH>   // C5
            , <&gpio0  4 GPIO_ACTIVE_HIGH>   // C6
            , <&gpio0  8 GPIO_ACTIVE_HIGH>   // C7
            , <&gpio0  6 GPIO_ACTIVE_HIGH>   // C8
            , <&gpio0 26 GPIO_ACTIVE_HIGH>   // C9
            , <&gpio0 30 GPIO_ACTIVE_HIGH>   // C10
            , <&gpio0 29 GPIO_ACTIVE_HIGH>   // C11
            , <&gpio0  2 GPIO_ACTIVE_HIGH>   // C12
            , <&gpio1 13 GPIO_ACTIVE_HIGH>   // C13
            , <&gpio0  3 GPIO_ACTIVE_HIGH>   // C14
            , <&gpio1 11 GPIO_ACTIVE_HIGH>   // C15
            ;
    };

    // Monochrome indicator LEDs.
    // Wiring per LED: 3.3V rail -> resistor -> LED anode (+),
    //                 LED cathode (-) -> GPIO.
    // Active-low: GPIO driven LOW turns the LED on (handled by gpio-leds).
    // NOTE: led index must match LED_* in src/czm_dz_87_indicator.c.
    //   CAPS / SL are on gpio0; BLE1..3 / USB are on gpio1.
    // (P0.31 STBY is the hardware charge lamp chain and is NOT managed here.)
    leds {
        compatible = "gpio-leds";
        label = "CZM DZ 87 indicator LEDs";
        led0: led_0 { gpios = <&gpio0 20 GPIO_ACTIVE_LOW>; };  // CapsLock
        led1: led_1 { gpios = <&gpio0 22 GPIO_ACTIVE_LOW>; };  // ScrollLock
        led2: led_2 { gpios = <&gpio1  0 GPIO_ACTIVE_LOW>; };  // BLE profile 1
        led3: led_3 { gpios = <&gpio1  2 GPIO_ACTIVE_LOW>; };  // BLE profile 2
        led4: led_4 { gpios = <&gpio1  4 GPIO_ACTIVE_LOW>; };  // BLE profile 3
        led5: led_5 { gpios = <&gpio1  6 GPIO_ACTIVE_LOW>; };  // USB output
    };
};
