            , <&key_physical_attrs 100 100  1400 525   0 0 0>  // p78 m77 MO2(右shift旁1u变体键)
            , <&key_physical_attrs 100 100  1625 525   0 0 0>  // p79 m78 UP
            , <&key_physical_attrs 125 100     0 625   0 0 0>  // p80 m80 LCTRL
