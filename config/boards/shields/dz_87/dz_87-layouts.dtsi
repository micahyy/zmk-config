            , <&key_physical_attrs 125 100   250 625   0 0 0>  // p82 m82 LALT
            , <&key_physical_attrs 225 100   375 625   0 0 0>  // p83 m84 SPACE(分裂空格左2.25u)
            , <&key_physical_attrs 125 100   600 625   0 0 0>  // p84 m85 SPACE(分裂空格中1.25u)
            , <&key_physical_attrs 100 100  3800 625   0 0 0>  // p85 m86 SPACE(6.25u整空格变体,不焊接 已移出显示)
            , <&key_physical_attrs 275 100   725 625   0 0 0>  // p86 m88 SPACE(分裂空格右2.75u)
            , <&key_physical_attrs 125 100  1000 625   0 0 0>  // p87 m90 RALT
            , <&key_physical_attrs 125 100  1125 625   0 0 0>  // p88 m91 RGUI
            , <&key_physical_attrs 125 100  1250 625   0 0 0>  // p89 m92 FN(mo1)
            , <&key_physical_attrs 125 100  1375 625   0 0 0>  // p90 m93 RCTRL
            , <&key_physical_attrs 100 100  1525 625   0 0 0>  // p91 m79 LEFT
            , <&key_physical_attrs 100 100  1625 625   0 0 0>  // p92 m94 DOWN
            , <&key_physical_attrs 100 100  1725 625   0 0 0>  // p93 m95 RIGHT
         

            ;
    };

