#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    // CZM DZ 87 wireless TKL. 6 rows x 16 columns, 96 positions.
    //
    // Position index = row * 16 + col and the matrix maps 1:1 (no column
    // reordering), so the transform is the identity. Key geometry below
    // follows the TKL layout: wide keys get their real width in 1u=100
    // units; unused split/ISO matrix positions are present as 1u entries
    // (they carry &none in the base keymap and only matter for Studio's
    // complete position accounting).
    dz87_transform: dz87_transform {
        compatible = "zmk,matrix-transform";
        columns = <16>;
        rows = <6>;
        map = <
            RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)  RC(0,5)  RC(0,6)  RC(0,7)
            RC(0,8)  RC(0,9)  RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14) RC(0,15)
            RC(1,0)  RC(1,1)  RC(1,2)  RC(1,3)  RC(1,4)  RC(1,5)  RC(1,6)  RC(1,7)
            RC(1,8)  RC(1,9)  RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14) RC(1,15)
            RC(2,0)  RC(2,1)  RC(2,2)  RC(2,3)  RC(2,4)  RC(2,5)  RC(2,6)  RC(2,7)
            RC(2,8)  RC(2,9)  RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,14) RC(2,15)
            RC(3,0)  RC(3,1)  RC(3,2)  RC(3,3)  RC(3,4)  RC(3,5)  RC(3,6)  RC(3,7)
            RC(3,8)  RC(3,9)  RC(3,10) RC(3,11) RC(3,12) RC(3,13) RC(3,14) RC(3,15)
            RC(4,0)  RC(4,1)  RC(4,2)  RC(4,3)  RC(4,4)  RC(4,5)  RC(4,6)  RC(4,7)
            RC(4,8)  RC(4,9)  RC(4,10) RC(4,11) RC(4,12) RC(4,13) RC(4,14) RC(4,15)
            RC(5,0)  RC(5,1)  RC(5,2)  RC(5,3)  RC(5,4)  RC(5,5)  RC(5,6)  RC(5,7)
            RC(5,8)  RC(5,9)  RC(5,10) RC(5,11) RC(5,12) RC(5,13) RC(5,14) RC(5,15)
        >;
    };

    dz87_layout: dz87_layout {
        compatible = "zmk,physical-layout";
        display-name = "CZM DZ 87 TKL";
        transform = <&dz87_transform>;

        // key_physical_attrs <width height x y rotation rx ry>; 1u = 100.
        // Each entry = one matrix position in row-major order (96 total).
        keys
            // ---- row 0 (function row): 13x1u esc/F + 3x1u nav (PrtScr/ScrLk/Pause)
            // ESC  F1  F2  F3  F4  F5  F6  F7  F8  F9  F10  F11  F12 | PrtScr ScrLk Pause
            = <&key_physical_attrs 100 100    0   0   0 0 0>
            , <&key_physical_attrs 100 100  150   0   0 0 0>
            , <&key_physical_attrs 100 100  250   0   0 0 0>
            , <&key_physical_attrs 100 100  350   0   0 0 0>
            , <&key_physical_attrs 100 100  450   0   0 0 0>
            , <&key_physical_attrs 100 100  550   0   0 0 0>
            , <&key_physical_attrs 100 100  650   0   0 0 0>
            , <&key_physical_attrs 100 100  750   0   0 0 0>
            , <&key_physical_attrs 100 100  850   0   0 0 0>
            , <&key_physical_attrs 100 100  950   0   0 0 0>
            , <&key_physical_attrs 100 100 1050   0   0 0 0>
            , <&key_physical_attrs 100 100 1150   0   0 0 0>
            , <&key_physical_attrs 100 100 1250   0   0 0 0>
            , <&key_physical_attrs 100 100 1400 0 0 0 0>
            , <&key_physical_attrs 100 100 1500   0   0 0 0>
            , <&key_physical_attrs 100 100 1600   0   0 0 0>
            // ---- row 1: ` 1..0 - = [BKSP 2u] | INS HOME
            , <&key_physical_attrs 100 100    0 100   0 0 0>
            , <&key_physical_attrs 100 100  100 100   0 0 0>
            , <&key_physical_attrs 100 100  200 100   0 0 0>
            , <&key_physical_attrs 100 100  300 100   0 0 0>
            , <&key_physical_attrs 100 100  400 100   0 0 0>
            , <&key_physical_attrs 100 100  500 100   0 0 0>
            , <&key_physical_attrs 100 100  600 100   0 0 0>
            , <&key_physical_attrs 100 100  700 100   0 0 0>
            , <&key_physical_attrs 100 100  800 100   0 0 0>
            , <&key_physical_attrs 100 100  900 100   0 0 0>
            , <&key_physical_attrs 100 100 1000 100   0 0 0>
            , <&key_physical_attrs 100 100 1100 100   0 0 0>
            , <&key_physical_attrs 100 100 1200 100   0 0 0>
            , <&key_physical_attrs 200 100 1300 100   0 0 0>
            , <&key_physical_attrs 100 100 1400 100   0 0 0>
            , <&key_physical_attrs 100 100 1500 100   0 0 0>
            // ---- row 2: TAB(1.5u) Q..P [ ] \ (1.5u) | DEL END
            , <&key_physical_attrs 150 100    0 200   0 0 0>
            , <&key_physical_attrs 100 100  150 200   0 0 0>
            , <&key_physical_attrs 100 100  250 200   0 0 0>
            , <&key_physical_attrs 100 100  350 200   0 0 0>
            , <&key_physical_attrs 100 100  450 200   0 0 0>
            , <&key_physical_attrs 100 100  550 200   0 0 0>
            , <&key_physical_attrs 100 100  650 200   0 0 0>
            , <&key_physical_attrs 100 100  750 200   0 0 0>
            , <&key_physical_attrs 100 100  850 200   0 0 0>
            , <&key_physical_attrs 100 100  950 200   0 0 0>
            , <&key_physical_attrs 100 100 1050 200   0 0 0>
            , <&key_physical_attrs 100 100 1150 200   0 0 0>
            , <&key_physical_attrs 100 100 1250 200   0 0 0>
            , <&key_physical_attrs 150 100 1350 200   0 0 0>
            , <&key_physical_attrs 100 100 1400 200   0 0 0>
            , <&key_physical_attrs 100 100 1500 200   0 0 0>
            // ---- row 3: CAPS(1.75u) A..L ; ' [ISO extra] ENTER(2.25u) | none none
            , <&key_physical_attrs 175 100    0 300   0 0 0>
            , <&key_physical_attrs 100 100  175 300   0 0 0>
            , <&key_physical_attrs 100 100  275 300   0 0 0>
            , <&key_physical_attrs 100 100  375 300   0 0 0>
            , <&key_physical_attrs 100 100  475 300   0 0 0>
            , <&key_physical_attrs 100 100  575 300   0 0 0>
            , <&key_physical_attrs 100 100  675 300   0 0 0>
            , <&key_physical_attrs 100 100  775 300   0 0 0>
            , <&key_physical_attrs 100 100  875 300   0 0 0>
            , <&key_physical_attrs 100 100  975 300   0 0 0>
            , <&key_physical_attrs 100 100 1075 300   0 0 0>
            , <&key_physical_attrs 100 100 1175 300   0 0 0>
            , <&key_physical_attrs 100 100 1275 300   0 0 0>
            , <&key_physical_attrs 225 100 1300 300   0 0 0>
            , <&key_physical_attrs 100 100 1400 300   0 0 0>
            , <&key_physical_attrs 100 100 1500 300   0 0 0>
            // ---- row 4: LSHIFT(2.25u) NUBS(1u) Z..M , . / RSHIFT(1.75u) FN2 UP LEFT
            , <&key_physical_attrs 225 100    0 400   0 0 0>
            , <&key_physical_attrs 100 100  225 400   0 0 0>
            , <&key_physical_attrs 100 100  325 400   0 0 0>
            , <&key_physical_attrs 100 100  425 400   0 0 0>
            , <&key_physical_attrs 100 100  525 400   0 0 0>
            , <&key_physical_attrs 100 100  625 400   0 0 0>
            , <&key_physical_attrs 100 100  725 400   0 0 0>
            , <&key_physical_attrs 100 100  825 400   0 0 0>
            , <&key_physical_attrs 100 100  925 400   0 0 0>
            , <&key_physical_attrs 100 100 1025 400   0 0 0>
            , <&key_physical_attrs 100 100 1125 400   0 0 0>
            , <&key_physical_attrs 100 100 1225 400   0 0 0>
            , <&key_physical_attrs 175 100 1325 400   0 0 0>
            , <&key_physical_attrs 100 100 1500 400   0 0 0>
            , <&key_physical_attrs 100 100 1600 400   0 0 0>
            , <&key_physical_attrs 100 100 1500 400   0 0 0>
            // ---- row 5: LCTRL LGUI LALT none SPC2.25 SPC1.25 SPC none SPC2.75 BKSP RALT RGUI FN RCTRL DOWN RIGHT
            , <&key_physical_attrs 125 100    0 500   0 0 0>
            , <&key_physical_attrs 125 100  125 500   0 0 0>
            , <&key_physical_attrs 125 100  250 500   0 0 0>
            , <&key_physical_attrs 125 100  375 500   0 0 0>
            , <&key_physical_attrs 225 100  500 500   0 0 0>
            , <&key_physical_attrs 125 100  725 500   0 0 0>
            , <&key_physical_attrs 125 100  850 500   0 0 0>
            , <&key_physical_attrs 125 100  975 500   0 0 0>
            , <&key_physical_attrs 275 100 1100 500   0 0 0>
            , <&key_physical_attrs 100 100 1375 500   0 0 0>
            , <&key_physical_attrs 125 100  100 600   0 0 0>
            , <&key_physical_attrs 125 100  225 600   0 0 0>
            , <&key_physical_attrs 125 100  350 600   0 0 0>
            , <&key_physical_attrs 125 100  475 600   0 0 0>
            , <&key_physical_attrs 100 100 1600 500   0 0 0>
            , <&key_physical_attrs 100 100 1500 500   0 0 0>
            ;
    };
};
