#include <dt-bindings/led/led.h>

// WS2812: 17 per-key LEDs, data on P0.26 via SPIM3
// Board-specific overlay: pinctrl/SPI hardware definition.
// Underglow chosen node is set by the shield overlay (dz17.overlay)
// to route through indicator_proxy. Do NOT set it here.

&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 26)>;
        };
    };
    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 26)>;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        status = "okay";
        reg = <0>;
        spi-max-frequency = <4000000>;
        chain-length = <17>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
    };
};
