if SHIELD_DZ17

config ZMK_KEYBOARD_NAME
    default "DZ17"

# Kconfig defaults only for items that must be guaranteed at Kconfig layer.
# Runtime feature flags (RGB/LED strip/battery) live in dz17.conf instead,
# matching the convention used by in-tree ZMK shields like Corne/Kyria.

# WS2812 RGB underglow: 17 per-key LEDs on P0.26
config ZMK_RGB_UNDERGLOW
    default y

config LED_STRIP
    default y

config WS2812_STRIP
    default y

endif
