#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Default numpad
        // NUM key = LT(1): tap NumLock, hold to access layer 1
        //
        //   LT(1)  /     *     -
        //   7      8     9     +
        //   4      5     6     Enter
        //   1      2     3
        //   0            .
        default_layer {
            bindings = <
                &lt 1 KP_NUMLOCK  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp KP_MINUS
                &kp KP_N7         &kp KP_N8      &kp KP_N9        &kp KP_PLUS
                &kp KP_N4         &kp KP_N5      &kp KP_N6        &kp KP_ENTER
                &kp KP_N1         &kp KP_N2      &kp KP_N3
                &kp KP_N0                        &kp KP_DOT
            >;
        };

        // Layer 1 (hold NUM): RGB controls + Bluetooth, matching DS17R6 QMK layout
        //
        //   trans  trans  *Studio    - BRI+
        //   TOG    SATU   trans      + BRI-
        //   HUD    trans  HUI        Enter trans
        //   BT0    BT1    BT2
        //   EFF                   BT_CLR
        //
        // * key = ZMK Studio unlock (hold NUM, press * to enable live editing)
        fn_layer {
            bindings = <
                &trans             &trans             &studio_unlock      &rgb_ug RGB_BRI
                &rgb_ug RGB_TOG    &rgb_ug RGB_SAI    &trans              &rgb_ug RGB_BRD
                &rgb_ug RGB_HUD    &trans             &rgb_ug RGB_HUI     &trans
                &bt BT_SEL 0       &bt BT_SEL 1       &bt BT_SEL 2
                &rgb_ug RGB_EFF                       &bt BT_CLR
            >;
        };
    };
};
