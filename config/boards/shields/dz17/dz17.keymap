#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/reset.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Default numpad
        // NUM key = LT(1): tap NumLock, hold to access FN layer
        // "/" key = LT(2): tap Divide, hold to access RGB layer
        //
        //   LT(1)  LT(2)  *      -
        //   7      8      9      +
        //   4      5      6      Enter
        //   1      2      3
        //   0             .
        default_layer {
            bindings = <
                &lt 1 KP_NUMLOCK  &lt 2 KP_DIVIDE  &kp KP_MULTIPLY  &kp KP_MINUS
                &kp KP_N7         &kp KP_N8        &kp KP_N9        &kp KP_PLUS
                &kp KP_N4         &kp KP_N5        &kp KP_N6        &kp KP_ENTER
                &kp KP_N1         &kp KP_N2        &kp KP_N3
                &kp KP_N0                          &kp KP_DOT
            >;
        };

        // Layer 1 (hold NUM): Bluetooth + USB toggle + System
        //
        //   trans  trans  *Studio  - Bootloader
        //   trans  trans  trans    + trans
        //   OUT    trans  trans    Enter trans
        //   BT0    BT1    BT2
        //   trans            . BT_CLR
        //
        // * = ZMK Studio unlock
        // - = enter UF2 bootloader (USB connection required)
        // 4 = toggle output between USB and BLE
        // . = clear all BT pairings
        fn_layer {
            bindings = <
                &trans       &trans       &studio_unlock   &bootloader
                &trans       &trans       &trans           &trans
                &out OUT_TOG &trans       &trans           &trans
                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2
                &trans                      &bt BT_CLR
            >;
        };

        // Layer 2 (hold "/"): RGB controls
        //
        //   trans  trans  trans  trans
        //   7=TOG  8=BRI+ trans  trans
        //   trans  trans  trans  trans
        //   trans  2=BRI- trans
        //   0=EFF        trans
        rgb_layer {
            bindings = <
                &trans             &trans             &trans           &trans
                &rgb_ug RGB_TOG    &rgb_ug RGB_BRI    &trans           &trans
                &trans             &trans             &trans           &trans
                &trans             &rgb_ug RGB_BRD    &trans
                &rgb_ug RGB_EFF                      &trans
            >;
        };
    };
};
