#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Default numpad
        // NUM key = LT(1): tap NumLock, hold to access layer 1
        //
        //   LT(1)  /     *     -
        //   7      8     9     +
        //   4      5     6     Enter
        //   1      2     3
        //   0            .
        default_layer {
            bindings = <
                &lt 1 KP_NUMLOCK  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp KP_MINUS
                &kp KP_N7         &kp KP_N8      &kp KP_N9        &kp KP_PLUS
                &kp KP_N4         &kp KP_N5      &kp KP_N6        &kp KP_ENTER
                &kp KP_N1         &kp KP_N2      &kp KP_N3
                &kp KP_N0                        &kp KP_DOT
            >;
        };

        // Layer 1: Bluetooth channel selection (hold NUM to access)
        // 1/2/3 = BT profile 0/1/2 (tap to switch; if unpaired, auto-advertise)
        // 0 = clear current profile bond (for re-pairing)
        // . = RGB toggle
        fn_layer {
            bindings = <
                &trans    &trans      &trans      &trans
                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &trans
                &trans    &trans      &trans      &trans
                &trans    &trans      &trans
                &bt BT_CLR             &rgb_ug RGB_TOG
            >;
        };
    };
};
