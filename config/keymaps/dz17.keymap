#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/reset.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    // Logitech-style channel keys:
    //   TAP  FN+1/2/3  = switch channel (pairing kept, reconnect attempts)
    //   HOLD FN+1/2/3 (1s) = pairing mode: selects that channel and clears
    //                       its bond, so it fast-blinks and accepts a new
    //                       host. The &pair_X macro = BT_SEL X then BT_CLR;
    //                       &sel_X = BT_SEL X only (bond kept for reconnect).
    behaviors {
        pair1: pair_profile1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <50>;
            bindings = <&bt BT_SEL 0 &bt BT_CLR>;
        };
        pair2: pair_profile2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <50>;
            bindings = <&bt BT_SEL 1 &bt BT_CLR>;
        };
        pair3: pair_profile3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <50>;
            bindings = <&bt BT_SEL 2 &bt BT_CLR>;
        };
        sel1: select_profile1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>;
        };
        sel2: select_profile2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>;
        };
        sel3: select_profile3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>;
        };
        ch1: ch_key1 {
            compatible = "zmk,behavior-hold-tap";
            label = "CH1 (tap select / hold pair)";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <1000>;
            bindings = <&pair1 &sel1>;
        };
        ch2: ch_key2 {
            compatible = "zmk,behavior-hold-tap";
            label = "CH2 (tap select / hold pair)";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <1000>;
            bindings = <&pair2 &sel2>;
        };
        ch3: ch_key3 {
            compatible = "zmk,behavior-hold-tap";
            label = "CH3 (tap select / hold pair)";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <1000>;
            bindings = <&pair3 &sel3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Default numpad
        //   NUM = LT(1): tap NumLock, hold for FN layer
        //   /   = LT(2): tap Divide, hold for layer 2
        default_layer {
            bindings = <
                &lt 1 KP_NUMLOCK  &lt 2 KP_DIVIDE  &kp KP_MULTIPLY  &kp KP_MINUS
                &kp KP_N7         &kp KP_N8        &kp KP_N9        &kp KP_PLUS
                &kp KP_N4         &kp KP_N5        &kp KP_N6        &kp KP_ENTER
                &kp KP_N1         &kp KP_N2        &kp KP_N3
                &kp KP_N0                          &kp KP_DOT
            >;
        };

        // Layer 1 (hold NUM): Bluetooth + USB toggle + System
        //   FN+1/2/3 = TAP switch channel / HOLD 1s pairing mode,
        //   FN+4 = toggle USB/BLE,
        //   FN+* = Studio unlock, FN+- = bootloader, FN+. = clear pairings
        fn_layer {
            bindings = <
                &trans       &trans       &studio_unlock   &bootloader
                &trans       &trans       &trans           &trans
                &out OUT_TOG &trans       &trans           &trans
                &ch1 0 0     &ch2 0 0     &ch3 0 0
                &trans                      &bt BT_CLR
            >;
        };

        // Layer 2 (hold "/"): reserved. WS2812 RGB controls removed with the
        // monochrome LED conversion; layer kept so LT(2) stays valid.
        layer2 {
            bindings = <
                &trans &trans &trans &trans
                &trans &trans &trans &trans
                &trans &trans &trans &trans
                &trans &trans &trans
                &trans       &trans
            >;
        };
    };
};
